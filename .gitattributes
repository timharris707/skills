# Keep text files LF so tooling (e.g. the release workflow's changelog parser)
# never sees stray carriage returns, regardless of contributor platform.
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.pdf binary

# Unified patches require a space on empty context lines.
editions/codex/skills.patch whitespace=-blank-at-eol,-blank-at-eof
# Font licenses stay byte-identical to the copies the foundries publish.
site/src/fonts/**/OFL.txt whitespace=-blank-at-eol
# Reviewed sources live in skills/ and editions/codex/; CI verifies this output.
plugins/clickai-codex/** linguist-generated=true
