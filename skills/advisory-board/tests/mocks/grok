#!/usr/bin/env bash
# Mock xAI's official `grok` CLI. The review protocol is shared with the Gemini
# fixture; this wrapper adapts Grok's version/update surface and environment names.
set -u

mode="${MOCK_GROK_MODE:-go}"
if [ "${1:-}" = "version" ]; then
  if [ "$mode" = "nogo_version" ]; then exit 127; fi
  echo "grok ${MOCK_GROK_VERSION:-0.1.0}"
  exit 0
fi
if [ "${1:-}" = "update" ]; then
  if [ "${MOCK_GROK_UPDATE_FAIL:-0}" = "1" ]; then exit 1; fi
  echo "updated grok"
  exit 0
fi
if [ "${1:-}" = "models" ]; then
  echo "grok-4.5"
  exit 0
fi

export MOCK_GEMINI_MODE="$mode"
export MOCK_GEMINI_SCORE_MODE="${MOCK_GROK_SCORE_MODE:-${MOCK_GEMINI_SCORE_MODE:-default}}"
export MOCK_GEMINI_ENDORSE_MODE="${MOCK_GROK_ENDORSE_MODE:-${MOCK_GEMINI_ENDORSE_MODE:-ok}}"
exec "$(dirname "$0")/gemini" "$@"
