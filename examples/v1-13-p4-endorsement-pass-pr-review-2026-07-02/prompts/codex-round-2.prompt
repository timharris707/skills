+        n_endorse = len(rr.changes.get("endorsements") or [])
         print(f"wrote {changes_path} (advisory-board/changes@1 — validated; "
-              f"{len(rr.changes['edits'])} edit(s), {n_unresolved} unresolved)")
+              f"{len(rr.changes['edits'])} edit(s), {n_unresolved} unresolved, "
+              f"{n_endorse} endorsement row(s))")
