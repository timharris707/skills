diff --git a/skills/advisory-board/scripts/render_verdict.py b/skills/advisory-board/scripts/render_verdict.py
index 88a22b7..1ea796f 100644
--- a/skills/advisory-board/scripts/render_verdict.py
+++ b/skills/advisory-board/scripts/render_verdict.py
@@ -988,7 +988,7 @@ def _revision_handoff_fields(data: dict, run_dir, shape: str = "full-handoff") -
     changes.json / source-material / revised-draft reads, and NO spurious 'redline
     not rendered' warning when a --run points at a present-but-incoherent chain."""
     empty = {"redline_source_name": "", "redline_rows": [], "redline_note": "",
-             "patch_pre": "", "patch_note": ""}
+             "patch_pre": "", "patch_note": "", "endorsement_summary": ""}
     if shape != "full-handoff":
         return empty
     loaded = _load_revised_chain(data, run_dir)
@@ -1008,9 +1008,84 @@ def _revision_handoff_fields(data: dict, run_dir, shape: str = "full-handoff") -
         fields["redline_rows"] = rows
         fields["redline_note"] = _plain(note) if note else ""
         fields["redline_source_name"] = _plain(name)
+    # Endorsement outcomes (v1.13 P4, D13): a minimal per-edit position summary line
+    # + any objection notes, surfaced in the redline/patch section header area. Empty
+    # string when changes.json carries no endorsements — the {{ENDORSEMENT_SUMMARY}}
+    # line then drops (drop_empty_optionals), keeping an endorsement-less run's HTML
+    # byte-identical to a P2/P3 render.
+    fields["endorsement_summary"] = build_endorsement_summary_html(changes)
     return fields
 
 
+def _esc(text) -> str:
+    """HTML-escape + brace-neutralize an untrusted string for a RAW slot we assemble
+    ourselves (my structural tags pass through; only the interpolated model/seat text
+    is escaped, so the fragment renders as HTML with the data escaped)."""
+    return _nb(html.escape(str(text)))
+
+
+def build_endorsement_summary_html(changes: dict) -> str:
+    """A small RAW HTML block summarizing changes.json.endorsements (D13): one line
+    per edit ("N endorse / M object / K abstain"), a line per unresolved conflict
+    that drew votes, then any objection notes listed (seat + note). Returns "" when
+    there are no endorsement rows — the template line drops and the page stays
+    byte-identical to an endorsement-less render. Interpolated seat/note strings are
+    HTML-escaped (`_esc`); the surrounding tags are ours and pass through."""
+    rows = changes.get("endorsements") or []
+    if not rows:
+        return ""
+
+    def _tally(target_field, n):
+        counts = {"ENDORSE": 0, "OBJECT": 0, "ABSTAIN": 0}
+        for r in rows:
+            if r.get(target_field) == n and r.get("position") in counts:
+                counts[r["position"]] += 1
+        return counts
+
+    def _counts_phrase(c) -> str:
+        parts = []
+        if c["ENDORSE"]:
+            parts.append(f"{c['ENDORSE']} endorse")
+        if c["OBJECT"]:
+            parts.append(f"{c['OBJECT']} object")
+        if c["ABSTAIN"]:
+            parts.append(f"{c['ABSTAIN']} abstain")
+        return " / ".join(parts)
+
+    lines = ['<div class="endorse-summary">',
+             '<p class="endorse-head">Board endorsement — the non-revision seats '
+             'voted on each change:</p>', '<ul class="endorse-list">']
+    for edit in changes.get("edits") or []:
+        n = edit.get("n")
+        c = _tally("edit_n", n)
+        phrase = _counts_phrase(c)
+        if phrase:
+            lines.append(f'<li>edit {_esc(n)}: {phrase}</li>')
+    for i in range(1, len(changes.get("unresolved") or []) + 1):
+        c = _tally("unresolved_n", i)
+        phrase = _counts_phrase(c)
+        if phrase:
+            lines.append(f'<li>unresolved conflict {_esc(i)}: {phrase}</li>')
+    lines.append("</ul>")
+    objections = [r for r in rows if r.get("position") == "OBJECT" and r.get("note")]
+    if objections:
+        lines.append('<p class="endorse-obj-head">Objections on the record:</p>')
+        lines.append('<ul class="endorse-obj">')
+        for r in objections:
+            target = (f"edit {r['edit_n']}" if "edit_n" in r
+                      else f"unresolved conflict {r['unresolved_n']}")
+            # _flat collapses any whitespace run (an embedded newline included) to a
+            # single space so a multi-line OBJECT note stays ONE <li> summary line —
+            # the same discipline amendment text uses at every emission point (a raw
+            # newline in the note would otherwise split the summary across lines and
+            # feed the drop_empty_optionals blank-line regexes a shape they don't expect).
+            lines.append(f'<li>{_esc(r.get("seat", "?"))} on {_esc(target)}: '
+                         f'{_esc(_flat(r.get("note", "")))}</li>')
+        lines.append("</ul>")
+    lines.append("</div>")
+    return "\n".join(lines)
+
+
 def build_handoff_data(data: dict, run_dir=None, shape: str = "full-handoff") -> dict:
     verdict = data.get("verdict", "")
     lens_preset = data.get("lens_preset")
diff --git a/skills/advisory-board/tests/mocks/claude b/skills/advisory-board/tests/mocks/claude
index 2f2abe8..f38c5a4 100755
--- a/skills/advisory-board/tests/mocks/claude
+++ b/skills/advisory-board/tests/mocks/claude
@@ -64,6 +64,12 @@ case "$prompt" in *"PRIOR RUN CONTEXT"*) is_ask=1; is_review=0 ;; esac
 is_revision=0
 case "$prompt" in *"You are the REVISION seat"*) is_revision=1; is_review=0 ;; esac
 
+# `endorsement` (v1.13 P4): the endorsement prompt frames the seat as "an
+# ENDORSEMENT seat" and asks for one ENDORSE/OBJECT/ABSTAIN per target. It gets a
+# single fenced JSON `positions` reply, NOT a review or a revision.
+is_endorse=0
+case "$prompt" in *"You are an ENDORSEMENT seat"*) is_endorse=1; is_review=0 ;; esac
+
 # Which round is this? The round-N (N>=2) template header names the round; round 1
 # has no such marker. Used by the `moving` mode to shift its VERDICT across rounds.
 round=1
@@ -494,6 +500,108 @@ emit_revise() {
   esac
 }
 
+# v1.13 P4 endorsement emitters. The prompt enumerates the exact targets ("- edit_n
+# = N" / "- unresolved_n = N" lines under "The targets, by their stable ids:"). The
+# mock parses those lines and emits one position per target — no target-counting in
+# python needed. MOCK_CLAUDE_ENDORSE_MODE switches: ok (all ENDORSE) | object (all
+# ENDORSE except an OBJECT+note on the FIRST target) | abstain (all ABSTAIN) |
+# missing_target (drop the LAST target -> invalid -> retry -> dropped) | garbage
+# (non-JSON) | missing_fence (no closing fence). `endorse_source` is the prompt.
+endorse_mode="${MOCK_CLAUDE_ENDORSE_MODE:-ok}"
+
+# Emit the JSON `positions` entries for every target line in the prompt. $1 selects
+# the mode. Writes comma-separated JSON objects (no trailing comma).
+emit_endorse_positions() {
+  local pmode="$1" first=1 idx=0
+  # Pull the target roster lines: "- edit_n = N" and "- unresolved_n = N".
+  while IFS= read -r line; do
+    case "$line" in
+      *"- edit_n = "*|*"- unresolved_n = "*)
+        idx=$((idx + 1))
+        # missing_target: silently skip the target whose 1-based index is the LAST
+        # (we don't know the count up-front in one pass, so skip index 999 sentinel;
+        # handled specially below via a two-pass count instead).
+        local field num
+        case "$line" in
+          *"- edit_n = "*)       field="edit_n";       num="${line##*- edit_n = }" ;;
+          *"- unresolved_n = "*) field="unresolved_n"; num="${line##*- unresolved_n = }" ;;
+        esac
+        num="${num%% *}"
+        local pos="ENDORSE" note=""
+        case "$pmode" in
+          abstain) pos="ABSTAIN" ;;
+          object)  if [ "$idx" -eq 1 ]; then pos="OBJECT"; note=', "note": "this edit oversteps the finding"'; fi ;;
+        esac
+        if [ "$first" -eq 1 ]; then first=0; else printf ',\n'; fi
+        printf '    {"%s": %s, "position": "%s"%s}' "$field" "$num" "$pos" "$note"
+        ;;
+    esac
+  done <<EOF_TARGETS
+$prompt
+EOF_TARGETS
+  printf '\n'
+}
+
+# missing_target mode needs the LAST target dropped; do it by counting first.
+emit_endorse_positions_drop_last() {
+  local total=0
+  while IFS= read -r line; do
+    case "$line" in *"- edit_n = "*|*"- unresolved_n = "*) total=$((total + 1)) ;; esac
+  done <<EOF_COUNT
+$prompt
+EOF_COUNT
+  local first=1 idx=0
+  while IFS= read -r line; do
+    case "$line" in
+      *"- edit_n = "*|*"- unresolved_n = "*)
+        idx=$((idx + 1))
+        [ "$idx" -ge "$total" ] && continue   # drop the last target
+        local field num
+        case "$line" in
+          *"- edit_n = "*)       field="edit_n";       num="${line##*- edit_n = }" ;;
+          *"- unresolved_n = "*) field="unresolved_n"; num="${line##*- unresolved_n = }" ;;
+        esac
+        num="${num%% *}"
+        if [ "$first" -eq 1 ]; then first=0; else printf ',\n'; fi
+        printf '    {"%s": %s, "position": "ENDORSE"}' "$field" "$num"
+        ;;
+    esac
+  done <<EOF_TARGETS2
+$prompt
+EOF_TARGETS2
+  printf '\n'
+}
+
+emit_endorse() {
+  echo "model: ${model:-unknown}" >&2
+  case "$endorse_mode" in
+    garbage)
+      echo "<<<<<<<< BEGIN ENDORSEMENT >>>>>>>>"
+      echo "{ positions: not-valid-json"
+      echo "<<<<<<<< END ENDORSEMENT >>>>>>>>"
+      ;;
+    missing_fence)
+      echo "<<<<<<<< BEGIN ENDORSEMENT >>>>>>>>"
+      echo '{ "positions": [ {"edit_n": 1, "position": "ENDORSE"} ] }'
+      # no closing fence -> parse failure -> invalid -> retry -> dropped
+      ;;
+    missing_target)
+      echo "<<<<<<<< BEGIN ENDORSEMENT >>>>>>>>"
+      printf '{ "positions": [\n'
+      emit_endorse_positions_drop_last
+      printf '] }\n'
+      echo "<<<<<<<< END ENDORSEMENT >>>>>>>>"
+      ;;
+    *)
+      echo "<<<<<<<< BEGIN ENDORSEMENT >>>>>>>>"
+      printf '{ "positions": [\n'
+      emit_endorse_positions "$endorse_mode"
+      printf '] }\n'
+      echo "<<<<<<<< END ENDORSEMENT >>>>>>>>"
+      ;;
+  esac
+}
+
 case "$mode" in
   moving_cites)
     if [ "$is_review" = "1" ]; then emit_moving_cites; else echo "ready"; fi
@@ -525,6 +633,7 @@ case "$mode" in
         *)                emit_synth_ok ;;
       esac
     elif [ "$is_revision" = "1" ]; then emit_revise
+    elif [ "$is_endorse" = "1" ]; then emit_endorse
     elif [ "$is_review" = "1" ]; then emit_review
     elif [ "$is_ask" = "1" ]; then emit_answer
     else echo "ready"; fi
@@ -538,6 +647,7 @@ case "$mode" in
         *)                emit_synth_ok ;;
       esac
     elif [ "$is_revision" = "1" ]; then emit_revise
+    elif [ "$is_endorse" = "1" ]; then emit_endorse
     elif [ "$is_review" = "1" ]; then emit_review
     elif [ "$is_ask" = "1" ]; then emit_answer
     else echo "ready"; fi
diff --git a/skills/advisory-board/tests/mocks/codex b/skills/advisory-board/tests/mocks/codex
index 259f3c7..7467233 100755
--- a/skills/advisory-board/tests/mocks/codex
+++ b/skills/advisory-board/tests/mocks/codex
@@ -36,12 +36,17 @@ cat >/dev/null 2>&1
 
 # codex carries the prompt in argv; detect a round-1 prompt and the model id
 # (--config model=<id>), echoed back as the answered-model banner on stderr.
+prompt="$*"
 is_review=0
 case "$*" in *"MATERIAL UNDER REVIEW"*) is_review=1 ;; esac
 # `ask` (v1.12): a post-verdict cross-examination prompt carries the PRIOR RUN
 # CONTEXT fence and gets a short free-form answer (NOT a 7-section review).
 is_ask=0
 case "$*" in *"PRIOR RUN CONTEXT"*) is_ask=1; is_review=0 ;; esac
+# `endorsement` (v1.13 P4): the endorsement prompt frames the seat as "an
+# ENDORSEMENT seat" and asks for one ENDORSE/OBJECT/ABSTAIN per target.
+is_endorse=0
+case "$*" in *"You are an ENDORSEMENT seat"*) is_endorse=1; is_review=0 ;; esac
 model=""
 for a in "$@"; do
   case "$a" in model=*) model="${a#model=}" ;; esac
@@ -100,6 +105,53 @@ emit_answer() {
   echo "ASK ANSWER (codex): to your follow-up — the implementation risk I flagged is unchanged; the reviewed material still lacks that guard."
 }
 
+# v1.13 P4 endorsement (see the claude mock for the target-roster contract). The
+# prompt lists "- edit_n = N" / "- unresolved_n = N" targets; the mock emits one
+# position per target. MOCK_CODEX_ENDORSE_MODE: ok | object | abstain |
+# object_exotic (an OBJECT whose note carries non-ASCII 'é' and an embedded newline
+# -- exercises byte-determinism of the changes.json round-trip + the renderer's
+# multi-line-note handling) | missing_target (an empty positions array -> a vote is
+# missing for every target -> invalid -> retry -> dropped).
+endorse_mode="${MOCK_CODEX_ENDORSE_MODE:-ok}"
+emit_endorse() {
+  echo "model: ${model:-unknown}" >&2
+  if [ "$endorse_mode" = "missing_target" ]; then
+    echo "<<<<<<<< BEGIN ENDORSEMENT >>>>>>>>"
+    echo '{ "positions": [] }'
+    echo "<<<<<<<< END ENDORSEMENT >>>>>>>>"
+    return
+  fi
+  local first=1 idx=0 field num pos note line
+  echo "<<<<<<<< BEGIN ENDORSEMENT >>>>>>>>"
+  printf '{ "positions": [\n'
+  while IFS= read -r line; do
+    case "$line" in
+      *"- edit_n = "*|*"- unresolved_n = "*)
+        idx=$((idx + 1))
+        case "$line" in
+          *"- edit_n = "*)       field="edit_n";       num="${line##*- edit_n = }" ;;
+          *"- unresolved_n = "*) field="unresolved_n"; num="${line##*- unresolved_n = }" ;;
+        esac
+        num="${num%% *}"; pos="ENDORSE"; note=""
+        case "$endorse_mode" in
+          abstain) pos="ABSTAIN" ;;
+          object)  if [ "$idx" -eq 1 ]; then pos="OBJECT"; note=', "note": "codex objects: the edit does not fully close the finding"'; fi ;;
+          # object_exotic: a note with a non-ASCII char (é) AND a JSON-escaped newline
+          # (\n) inside the string — the exact bytes a real seat could emit. JSON
+          # parses the \n to a real newline; the round-trip + renderer must stay clean.
+          object_exotic) if [ "$idx" -eq 1 ]; then pos="OBJECT"; note=', "note": "codex objecte: la référence est ambiguë\nseconde ligne du grief"'; fi ;;
+        esac
+        if [ "$first" -eq 1 ]; then first=0; else printf ',\n'; fi
+        printf '    {"%s": %s, "position": "%s"%s}' "$field" "$num" "$pos" "$note"
+        ;;
+    esac
+  done <<EOF_TARGETS
+$prompt
+EOF_TARGETS
+  printf '\n] }\n'
+  echo "<<<<<<<< END ENDORSEMENT >>>>>>>>"
+}
+
 case "$mode" in
   nogo_smoke) exit 1 ;;
   empty)      exit 0 ;;
@@ -110,16 +162,33 @@ case "$mode" in
     else echo "ready"; fi
     exit 0 ;;
   timeout)    exec sleep 30 ;;   # exec so no orphaned sleep survives the kill
+  # endorse_empty: return a real round review but drop the endorsement (empty
+  # stdout -> NoOutput -> dropped rows). Lets a test exercise the failed-spawn arm.
+  endorse_empty)
+    if [ "$is_endorse" = "1" ]; then exit 0
+    elif [ "$is_review" = "1" ]; then emit_review; else echo "ready"; fi
+    exit 0 ;;
+  # endorse_sleep: reviews (and the smoke ping) return instantly, but the ENDORSEMENT
+  # spawn sleeps past any tiny per-seat --timeout, so a `--timeout codex=<tiny>` times
+  # out and drops ONLY codex's endorsement while its review + other seats vote normally.
+  endorse_sleep)
+    if [ "$is_endorse" = "1" ]; then exec sleep 30
+    elif [ "$is_review" = "1" ]; then emit_review; else echo "ready"; fi
+    exit 0 ;;
   stub)
     if [ "$is_review" = "1" ]; then echo "Done — wrote the review."; else echo "ready"; fi
     exit 0 ;;
   degraded)
     echo "warning: sandbox note" >&2
-    if [ "$is_review" = "1" ]; then emit_review; elif [ "$is_ask" = "1" ]; then emit_answer; else echo "ready"; fi
+    if [ "$is_review" = "1" ]; then emit_review
+    elif [ "$is_endorse" = "1" ]; then emit_endorse
+    elif [ "$is_ask" = "1" ]; then emit_answer; else echo "ready"; fi
     exit 1 ;;
   # Unknown model: codex emits an invalid_request_error to STDERR (grounded 2026-06-25).
   model_not_found) echo '{"type":"error","error":{"type":"invalid_request_error","message":"The model is not supported when using Codex with a ChatGPT account."}}' >&2; exit 1 ;;
   *)
-    if [ "$is_review" = "1" ]; then emit_review; elif [ "$is_ask" = "1" ]; then emit_answer; else echo "ready"; fi
+    if [ "$is_review" = "1" ]; then emit_review
+    elif [ "$is_endorse" = "1" ]; then emit_endorse
+    elif [ "$is_ask" = "1" ]; then emit_answer; else echo "ready"; fi
     exit 0 ;;
 esac
